# Midtrans — get keys from dashboard.midtrans.com > Settings > Access Keys
# Use sandbox keys while testing, then switch to production keys.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# "sandbox" or "production"
NEXT_PUBLIC_MIDTRANS_ENV=sandbox

# TrustBridge — paste the giving page link TrustBridge gives Bahtraku (leave empty until you have it)
NEXT_PUBLIC_TRUSTBRIDGE_URL=

# Public site URL (used for Midtrans redirect after payment)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
